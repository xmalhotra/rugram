{
  "name": "betterhabits-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev --port 3001",
    "mobile": "npm --prefix mobile start",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "test:mobile-api": "node scripts/test-mobile-api.mjs",
    "test:simulation": "QRAM_DEMO_MODE=true node --conditions=react-server --import tsx scripts/simulate-mobile.ts",
    "test:creator-quota-db": "node --conditions=react-server --import tsx scripts/test-creator-event-quota.ts",
    "test:admin-content": "node --conditions=react-server --import tsx scripts/test-admin-content.ts",
    "test:demo-journey": "node --conditions=react-server --import tsx scripts/test-demo-journey.ts",
    "test:hosted-events": "node --conditions=react-server --import tsx scripts/test-hosted-events.ts",
    "test:notifications": "node --conditions=react-server --import tsx scripts/test-notifications.ts",
    "test:reports": "node --conditions=react-server --import tsx scripts/test-reports.ts",
    "test:completion-replay": "node --conditions=react-server --import tsx scripts/test-completion-replay.ts",
    "test:community": "node --conditions=react-server --import tsx scripts/test-community.ts",
    "test:event-subscriptions": "node --conditions=react-server --import tsx scripts/test-event-subscriptions.ts",
    "test:event-waitlist": "node --conditions=react-server --import tsx scripts/test-event-waitlist.ts",
    "test:mobile-accessibility": "node scripts/check-mobile-accessibility.mjs",
    "test:load": "node scripts/load-mobile-api.mjs",
    "db:maintenance": "node scripts/database-maintenance.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:mobile": "eslint -c eslint.mobile.config.mjs mobile/App.tsx mobile/index.ts mobile/src mobile/app",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed-flow-resources": "node --import tsx scripts/seed-curated-flow-resources.ts",
    "db:seed-exercises": "node --conditions=react-server --import tsx scripts/seed-exercise-library.ts",
    "db:seed:routines": "node --conditions=react-server --import tsx scripts/seed-routines.ts",
    "db:seed:training": "node --conditions=react-server --import tsx scripts/seed-training.ts",
    "exercise:coverage": "node --import tsx scripts/exercise-coverage.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "node scripts/test-mobile-api.mjs",
    "test:legacy-web": "playwright test",
    "deploy:check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/three": "^0.185.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "postcss": "8.5.30",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
