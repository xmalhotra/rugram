# Copy this file to .env.local for local development. Never commit .env.local.

# Required when QRAM_DEMO_MODE=false.
# Use the pooled Neon Postgres URL for runtime traffic, with sslmode=require.
# Example: postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Required in every environment. Generate a unique value with:
# openssl rand -base64 48
# Do not expose this as NEXT_PUBLIC_*.
AUTH_SECRET=

# Canonical origin; no trailing slash.
APP_URL=http://localhost:3000

# Explicit deployment label for hosts without VERCEL_ENV. Use staging/preview/
# production on those deployments; APP_ENV=local cannot override NODE_ENV=production.
APP_ENV=local

# Safe default: database mode. For a local-only simulator, deliberately change
# this to true. Missing DATABASE_URL never enables demo mode automatically.
# Demo mode is refused in preview, staging and production, even with a database.
# BETTERHABITS_DEMO_MODE and RUGRAM_DEMO_MODE are still read as aliases; if more
# than one is set they must match.
QRAM_DEMO_MODE=false

# Local OTP simulator only. Shows the code in-app and never sends SMS.
# Disabled in production and database mode.
SMS_PROVIDER=mock

# Real SMS requires database mode, migration 014, and your approved OTP template.
# Set SMS_PROVIDER=msg91 only after configuring and testing these server-only values.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Alternatively, use SMS_PROVIDER=msg91-widget with mobile integration enabled.
# This is the widget ID from MSG91's integration panel, not its display name.
MSG91_WIDGET_ID=
# Client-side integration tokenAuth; separate from the account AUTH_KEY above.
# Keep both values server-side; do not use EXPO_PUBLIC variables for credentials.
MSG91_WIDGET_TOKEN=
# Match the configured widget's OTP length (4 or 6). Mock/template OTP stays 6.
MSG91_OTP_LENGTH=6

# Optional mail delivery for account email verification. Without these, local demo
# mode shows the code in the app and does not send mail.
RESEND_API_KEY=
EMAIL_FROM=

# Optional database driver. Neon HTTPS is the default for hosted Neon URLs.
# DATABASE_DRIVER=postgres
# Enable structured mobile request timing/error logs without request bodies.
# Structured request logs are on by default in preview, staging and production.
# Set API_TELEMETRY=false to opt out, or true to enable locally.
# API_TELEMETRY=true
# Number of trusted proxies that append to X-Forwarded-For (Vercel: 1). 0 ignores the header.
# TRUSTED_PROXY_HOPS=1

# Optional. Enables model-guided answers in Ask Qram. Without this, the app
# uses the same curated library and profile-aware recommendation fallback.
# OPENAI_API_KEY=
# OPENAI_QRAM_MODEL=gpt-5-mini (OPENAI_BETTERHABITS_MODEL and OPENAI_RUGRAM_MODEL are still read as aliases)

# Google Maps Platform key for event venue search and map images (Places API (New) + Maps Static API).
# Server-side only; restrict it to those two APIs in Google Cloud. Without it hosts type addresses by hand.
# GOOGLE_MAPS_API_KEY=

# Only for scripts/generate-exercise-icons.mjs. Never ship this in the app.
XAI_API_KEY=
XAI_IMAGE_MODEL=
